# Optional local settings. scripts/local-start.sh generates .env.local and a
# unique database password automatically; never commit the generated file.
# POSTGRES_PASSWORD=<generated automatically; do not use a shared default>
ARTEX_LOCAL_PORT=8787
ARTEX_LOCAL_PROXY_PORT=8788
# Configure a provider here or later through System > LLM in the application.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
